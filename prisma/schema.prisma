// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


//Se crea la tabla Roles, contiene el id y su nombre

model Roles {
  id_rol Int @id @default(autoincrement())
  nombre String
  
  usuarios Usuarios[]
}


//Se crea la tabla Usuarios, contiene el id, su nombre, correo, contraseña y fecha de creación. 
//También tiene los campos rol_id y grupo_id que se relacionan con la tablas correspondientes.

model Usuarios {
  id_usuario Int @id @default(autoincrement())
  nombre String
  correo_electronico String @unique
  password String
  fecha_creacion DateTime @default(now())
  rol_id Int
  grupo_id Int?

  rol Roles @relation(fields: [rol_id], references: [id_rol])
  grupo Grupos? @relation(fields: [grupo_id], references: [id_grupo])
  notificaciones Notificaciones[]
}


//Se crea la tabla Grupos, contiene el id, su nombre, fecha de registro. 
//También tiene el campo dispositivo_id que se relaciona con la tabla correspondiente.

model Grupos {
  id_grupo Int @id @default(autoincrement())
  nombre String
  fecha_registro DateTime @default(now())
  dispositivo_id Int

  dispositivo Dispositivos @relation(fields: [dispositivo_id], references: [id_dispositivo])
  usuario Usuarios[]
}


//Se crea la tabla Dispositivos, contiene el id, su nombre, tipo de dispositivo, direccion ip, estado y fecha de registro.

model Dispositivos {
  id_dispositivo Int @id @default(autoincrement())
  tipo String
  nombre String
  direccion_ip String @unique
  status Boolean @default(true)
  fecha_registro DateTime @default(now())

   grupo Grupos[]
}


//Se crea la tabla Notificaciones, contiene el id, su nombre, mensaje, fecha de registro, y el estado. 
//También tiene el campo usuario_id que se relaciona con la tabla correspondiente.

model Notificaciones {
  id_notificacion Int @id @default(autoincrement())
  mensaje String
  fecha_envio DateTime @default(now())
  status Boolean @default(false)
  usuario_id Int
  
  usuario Usuarios @relation(fields: [usuario_id], references: [id_usuario])
}